{
  "expo": {
    "name": "IMC-Mail",
    "slug": "imc-mail",
    "version": "2026.10.4",
    "scheme": [
      "imcmail",
      "com.itmecasey.imcmail"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-status-bar",
      "react-native-quick-crypto",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sqlite",
      "expo-background-task",
      "expo-sharing",
      "./plugins/withLiveMail",
      "./plugins/withNoMinify",
      [
        "expo-camera",
        {
          "cameraPermission": "IMC-Mail uses the camera only to scan the pairing code shown on your computer.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7d9fff"
        }
      ]
    ],
    "android": {
      "package": "com.itmecasey.imcmail",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "allowBackup": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [{ "scheme": "mailto" }]
        },
        {
          "action": "SENDTO",
          "category": ["DEFAULT"],
          "data": [{ "scheme": "mailto" }]
        }
      ]
    },
    "owner": "itmecasey",
    "extra": {
      "eas": {
        "projectId": "6d530fa1-b615-4d0f-b001-055780ed8a68"
      }
    }
  }
}
