{
  "name": "@imc/mail",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mail protocols for the phone: an IMAP client over a socket that is passed in, so it runs in React Native and in tests",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./render": "./src/render.ts",
    "./test-db": "./src/test-db.ts",
    "./holidays": "./src/holidays.ts",
    "./logo": "./src/logo.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@imc/core": "workspace:*",
    "date-holidays": "^3.38.0",
    "postal-mime": "^4.1.4",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "vitest": "^5.0.5",
    "@types/sanitize-html": "^2.16.2",
    "@types/node": "^26.6.5"
  }
}
