{
  "name": "imc-mail",
  "private": true,
  "version": "0.0.0",
  "description": "Multi-account email client for streamers and content creators",
  "scripts": {
    "dev": "pnpm --filter @imc/desktop dev",
    "build": "pnpm --filter @imc/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/next-version.test.mjs",
    "format": "prettier --write .",
    "version:next": "node scripts/next-version.mjs",
    "version:set": "node scripts/next-version.mjs --write"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
